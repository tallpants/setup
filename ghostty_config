font-family = Cascadia Code
font-size = 12
font-feature = -calt,-liga,-dlig
font-thicken = true
adjust-cell-height = 30%

notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 1m

cursor-style = block
shell-integration-features = no-cursor

window-padding-x = 15
window-padding-y = 15
window-padding-balance = true
unfocused-split-opacity = 0.5

# Play nice when SSHing into hosts that don't know `xterm-ghostty` in terminfo
shell-integration-features = ssh-env,ssh-terminfo

# macOS natural text editing
keybind = opt+backspace=text:\x17

auto-update = check

theme = VS Code Dark Modern
